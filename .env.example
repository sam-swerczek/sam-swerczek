# Supabase Configuration
# Find these values at: https://app.supabase.com/project/_/settings/api

# Project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon/Public Key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (NEVER expose this in client-side code or commit to git!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Allowlist (server-side only - do NOT prefix with NEXT_PUBLIC_)
# Comma-separated list of emails allowed into the /admin dashboard.
# Anyone can sign in with Google to leave comments, but only these emails
# are treated as admins. Match the email of your Google/admin account exactly.
ADMIN_EMAILS=you@example.com

# Site URL (for redirects and email links)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API Key (for AI blog post generation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
